set(CMAKE_SYSTEM_NAME Emscripten CACHE STRING "" FORCE)
set(CMAKE_SYSTEM_VERSION 1 CACHE STRING "" FORCE)
set(EMSCRIPTEN_ROOT "$ENV{EMSCRIPTEN_ROOT}")
include("${EMSCRIPTEN_ROOT}/cmake/Modules/Platform/Emscripten.cmake")

set(WASM_EH_FLAGS "-fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0 -sSUPPORT_LONGJMP=wasm")
set(CMAKE_C_FLAGS_INIT "-sSUPPORT_LONGJMP=wasm")
set(CMAKE_CXX_FLAGS_INIT "${WASM_EH_FLAGS}")
set(CMAKE_OBJC_FLAGS_INIT "${WASM_EH_FLAGS} -fobjc-runtime=gnustep-2.0")
set(CMAKE_OBJCXX_FLAGS_INIT "${WASM_EH_FLAGS} -fobjc-runtime=gnustep-2.0")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${WASM_EH_FLAGS} -Wl,--stack-first")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
